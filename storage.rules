rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /ads/{uid}/{fileName} {
      allow read: if true;
      // Scoped to the uploader's own uid, matching the profiles/ pattern below —
      // previously any signed-in user could overwrite or delete ANY ad photo
      // (the exact path is public, since it's the ad's own visible image URL).
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profiles/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /email-assets/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
