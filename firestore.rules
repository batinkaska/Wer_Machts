rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBlockedBy(recipientId, senderId) {
      return senderId in
        get(/databases/$(database)/documents/users/$(recipientId)).data.get('blockedUserIds', []);
    }

    // The payment recipient is whichever side of the deal is NOT the one who pays:
    // on a "biete" ad the bidder pays the ad owner, on a "suche" ad the ad owner pays the bidder.
    function bidPaymentRecipientId(bidId) {
      let bid = get(/databases/$(database)/documents/bids/$(bidId)).data;
      let ad = get(/databases/$(database)/documents/ads/$(bid.adId)).data;
      return ad.adKind == 'biete' ? ad.ownerId : bid.providerId;
    }

    // Full user document — email, phone, delivery address, Stripe IDs, favorites,
    // blocked users… — is private to its owner. Everything other people may see
    // lives in publicProfiles/{uid}, mirrored server-side by onUserWritten.
    // The payer is the bidder on a "biete" ad (they buy the offered service)
    // and the ad owner on a "suche" ad (they hire the bidder).
    function bidPayerId(bid) {
      let ad = get(/databases/$(database)/documents/ads/$(bid.adId)).data;
      return ad.adKind == 'biete' ? bid.providerId : ad.ownerId;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      // Pro/Stripe fields are only ever trustworthy when written by the Cloud
      // Functions (webhook/callables, Admin SDK bypasses rules) — a plain
      // client write must never be able to grant itself Pro status.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.get('isPro', false) == resource.data.get('isPro', false)
        && request.resource.data.get('proStatus', null) == resource.data.get('proStatus', null)
        && request.resource.data.get('proPlan', null) == resource.data.get('proPlan', null)
        && request.resource.data.get('proCurrentPeriodEnd', null) == resource.data.get('proCurrentPeriodEnd', null)
        && request.resource.data.get('proTrialEnd', null) == resource.data.get('proTrialEnd', null)
        && request.resource.data.get('proTrialUsed', false) == resource.data.get('proTrialUsed', false)
        && request.resource.data.get('proCancelAtPeriodEnd', false) == resource.data.get('proCancelAtPeriodEnd', false)
        && request.resource.data.get('stripeCustomerId', null) == resource.data.get('stripeCustomerId', null)
        && request.resource.data.get('stripeSubscriptionId', null) == resource.data.get('stripeSubscriptionId', null)
        && request.resource.data.get('featuredAdId', null) == resource.data.get('featuredAdId', null);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /publicProfiles/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /ads/{adId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (
          resource.data.ownerId == request.auth.uid
          // isFeatured is only ever trustworthy when set by the setFeaturedAd
          // Cloud Function (Admin SDK) after verifying Pro status.
          && request.resource.data.get('isFeatured', false) == resource.data.get('isFeatured', false)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bidCount', 'updatedAt']) &&
          request.resource.data.bidCount == resource.data.bidCount + 1
        )
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /bids/{bidId} {
      allow read: if true;
      // A new bid always starts as a plain pending offer — payment/acceptance
      // fields can never be pre-filled (otherwise anyone could fabricate an
      // "accepted + paid" deal that shows up as completed work on a profile).
      allow create: if isSignedIn()
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.keys().hasOnly(
          ['adId', 'adTitle', 'adKind', 'providerId', 'providerName', 'amount', 'message', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && get(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.ownerId != request.auth.uid;

      // Clients may only ever touch these four fields, each under its own
      // condition. Everything else — amount, providerId, adId, and all payment
      // fields (paymentStatus, stripePaymentIntentId, supportAmount,
      // processingFee) — is immutable from the client: payment state is only
      // ever set by the Cloud Functions (Admin SDK) after verifying with Stripe,
      // and the amount can never be changed after the fact (a payer could
      // otherwise lower it to 1 € right before paying).
      allow update: if isSignedIn() && (
        resource.data.providerId == request.auth.uid ||
        get(/databases/$(database)/documents/ads/$(resource.data.adId)).data.ownerId == request.auth.uid
      )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'paymentMethod', 'hiddenFromProfile', 'hiddenForUserIds'])
        // Only the ad owner decides on a pending bid, and only once.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || (
            get(/databases/$(database)/documents/ads/$(resource.data.adId)).data.ownerId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'rejected']
          )
        )
        // Only the payer may switch to cash, only on an accepted (or being
        // accepted) deal, and never once a card payment has gone through.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentMethod']) || (
            request.auth.uid == bidPayerId(resource.data)
            && request.resource.data.paymentMethod == 'cash'
            && request.resource.data.status == 'accepted'
            && resource.data.get('paymentStatus', null) != 'paid'
          )
        )
        // Each party can only add themselves to their own hide-list.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hiddenForUserIds']) ||
          request.resource.data.hiddenForUserIds.toSet()
            == resource.data.get('hiddenForUserIds', []).toSet().union([request.auth.uid].toSet())
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hiddenFromProfile']) ||
          request.resource.data.hiddenFromProfile == true
        );
      allow delete: if isSignedIn() && (
        resource.data.providerId == request.auth.uid ||
        get(/databases/$(database)/documents/ads/$(resource.data.adId)).data.ownerId == request.auth.uid
      );

      // Bank details for the manual payout — only the person who is actually
      // getting paid may ever read or write their own IBAN, never the payer.
      match /private/bankDetails {
        allow read, write: if isSignedIn() && request.auth.uid == bidPaymentRecipientId(bidId);
      }
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.senderId == request.auth.uid
        && !isBlockedBy(request.resource.data.recipientId, request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.recipientId;
      // Only the two notification types with no ad/bid/message behind them may
      // still be created directly by a client — bid_placed, bid_accepted,
      // bid_rejected, message and payment_confirmed are all derived server-side
      // (Admin SDK, bypasses these rules) from the real bid/message/payment
      // document instead, so an attacker can no longer forge an arbitrary
      // recipient/sender/subject to spam or phish someone via a fake
      // notification (which — since notifications now trigger real emails —
      // would otherwise be a real abuse vector).
      allow create: if isSignedIn() && request.resource.data.actorId == request.auth.uid && (
        (request.resource.data.type == 'verify_phone' && request.resource.data.recipientId == request.auth.uid) ||
        (request.resource.data.type == 'new_follower' && request.resource.data.recipientId != request.auth.uid)
      );
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // Reviews are only ever written by the submitReview Cloud Function
      // (Admin SDK, bypasses these rules), which verifies the reviewer and
      // reviewee actually shared a real conversation first — a plain client
      // write here had no way to check that, letting anyone post a fake
      // rating for any account.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
