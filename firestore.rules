rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBlockedBy(recipientId, senderId) {
      return senderId in
        get(/databases/$(database)/documents/users/$(recipientId)).data.get('blockedUserIds', []);
    }

    // The payment recipient is whichever side of the deal is NOT the one who pays:
    // on a "biete" ad the bidder pays the ad owner, on a "suche" ad the ad owner pays the bidder.
    function bidPaymentRecipientId(bidId) {
      let bid = get(/databases/$(database)/documents/bids/$(bidId)).data;
      let ad = get(/databases/$(database)/documents/ads/$(bid.adId)).data;
      return ad.adKind == 'biete' ? ad.ownerId : bid.providerId;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == uid;
      // Pro/Stripe fields are only ever trustworthy when written by the Cloud
      // Functions (webhook/callables, Admin SDK bypasses rules) — a plain
      // client write must never be able to grant itself Pro status.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.get('isPro', false) == resource.data.get('isPro', false)
        && request.resource.data.get('proStatus', null) == resource.data.get('proStatus', null)
        && request.resource.data.get('proPlan', null) == resource.data.get('proPlan', null)
        && request.resource.data.get('proCurrentPeriodEnd', null) == resource.data.get('proCurrentPeriodEnd', null)
        && request.resource.data.get('proTrialEnd', null) == resource.data.get('proTrialEnd', null)
        && request.resource.data.get('proTrialUsed', false) == resource.data.get('proTrialUsed', false)
        && request.resource.data.get('proCancelAtPeriodEnd', false) == resource.data.get('proCancelAtPeriodEnd', false)
        && request.resource.data.get('stripeCustomerId', null) == resource.data.get('stripeCustomerId', null)
        && request.resource.data.get('stripeSubscriptionId', null) == resource.data.get('stripeSubscriptionId', null)
        && request.resource.data.get('featuredAdId', null) == resource.data.get('featuredAdId', null);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /ads/{adId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (
          resource.data.ownerId == request.auth.uid
          // isFeatured is only ever trustworthy when set by the setFeaturedAd
          // Cloud Function (Admin SDK) after verifying Pro status.
          && request.resource.data.get('isFeatured', false) == resource.data.get('isFeatured', false)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bidCount', 'updatedAt']) &&
          request.resource.data.bidCount == resource.data.bidCount + 1
        )
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /bids/{bidId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.providerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.providerId == request.auth.uid ||
        get(/databases/$(database)/documents/ads/$(resource.data.adId)).data.ownerId == request.auth.uid
      )
        // paymentStatus / stripePaymentIntentId are only ever trustworthy when set by
        // the Cloud Functions (Admin SDK, bypasses rules) after verifying with Stripe —
        // a plain client write must never be able to change them.
        && request.resource.data.get('paymentStatus', null) == resource.data.get('paymentStatus', null)
        && request.resource.data.get('stripePaymentIntentId', null) == resource.data.get('stripePaymentIntentId', null)
        && request.resource.data.get('supportAmount', null) == resource.data.get('supportAmount', null);
      allow delete: if isSignedIn() && (
        resource.data.providerId == request.auth.uid ||
        get(/databases/$(database)/documents/ads/$(resource.data.adId)).data.ownerId == request.auth.uid
      );

      // Bank details for the manual payout — only the person who is actually
      // getting paid may ever read or write their own IBAN, never the payer.
      match /private/bankDetails {
        allow read, write: if isSignedIn() && request.auth.uid == bidPaymentRecipientId(bidId);
      }
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.senderId == request.auth.uid
        && !isBlockedBy(request.resource.data.recipientId, request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.recipientId;
      allow create: if isSignedIn() && request.resource.data.actorId == request.auth.uid;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.revieweeId != request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if false;
      allow delete: if false;
    }
  }
}
